# Terrapin Events - Environment Variables Template
# Copy this file to .env and fill in your values

# Application
APP_NAME=Terrapin Events API
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development

# MongoDB Configuration
MONGODB_URL=mongodb://mongo:27017
MONGODB_DB_NAME=terrapin_events

# JWT Configuration
# IMPORTANT: Generate a secure secret key with: openssl rand -hex 32
JWT_SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Password Hashing
BCRYPT_ROUNDS=12

# CORS (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]


# SMTP / Email configuration
# Example for Gmail (use an App Password, not your real password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@umd.edu
# SMTP_PASSWORD=your_app_password
# SMTP_FROM_EMAIL=your_email@umd.edu
# SMTP_FROM_NAME="Terrapin Events"