# Application Settings
APP_NAME=Terrapin Events API
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development

# Database
MONGODB_URL=mongodb://mongo:27017
MONGODB_DB_NAME=terrapin_events

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Password Hashing
BCRYPT_ROUNDS=12

# Email / SMTP Configuration (Required for email notifications)
# For Gmail: Use App Password (not your regular password)
# 1. Enable 2FA on your Google account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Generate an app password for "Mail"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=vineetagarwal54@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Terrapin Events

# Alternative: Mailtrap (for testing without sending real emails)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USERNAME=your-mailtrap-username
# SMTP_PASSWORD=your-mailtrap-password
# SMTP_FROM_EMAIL=noreply@terrapinevent.com
# SMTP_FROM_NAME=Terrapin Events

# Alternative: SendGrid
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SMTP_FROM_EMAIL=noreply@terrapinevent.com
# SMTP_FROM_NAME=Terrapin Events
